# Copy to .env and fill in real values. Never commit .env.

# Local dev: SQLite file (relative to prisma/). Production: a Turso libsql://
# URL (SQLite files do not persist on Vercel's serverless runtime) — see
# TURSO_AUTH_TOKEN below and CLAUDE.md's Deployment section.
DATABASE_URL="file:./dev.db"

# Production only: Turso auth token, paired with a libsql:// DATABASE_URL.
# Required whenever DATABASE_URL is libsql://... — lib/db.ts refuses to
# connect unauthenticated and will throw at startup if this is missing.
TURSO_AUTH_TOKEN=""

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Used by prisma/seed.ts to create the initial admin account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Production only: Vercel Blob token for resume/image uploads.
# BLOB_READ_WRITE_TOKEN=""

# Canonical site URL, used in metadata, sitemap.xml, robots.txt, and OG images.
# Defaults to http://localhost:3000 if unset.
SITE_URL="http://localhost:3000"
