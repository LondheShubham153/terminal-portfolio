# Copy to .env and fill in real values. Never commit .env.

# Local dev: SQLite file. Production: a Turso/libSQL or Postgres connection string
# (SQLite files do not persist on Vercel's serverless runtime).
DATABASE_URL="file:./dev.db"

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Used by prisma/seed.ts to create the initial admin account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Production only: Vercel Blob token for resume/image uploads.
# BLOB_READ_WRITE_TOKEN=""

# Canonical site URL, used in metadata, sitemap.xml, robots.txt, and OG images.
# Defaults to http://localhost:3000 if unset.
SITE_URL="http://localhost:3000"
